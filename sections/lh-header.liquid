<header class="lh-header" {{ section.shopify_attributes }}>
  <a class="lh-header__logo" href="{{ routes.root_url }}">{{ section.settings.logo_text | escape }}</a>

  {%- if section.settings.tagline != blank -%}
    <p class="lh-header__tagline">{{ section.settings.tagline | escape }}</p>
  {%- endif -%}

  <div class="lh-header__actions">
    {%- if section.settings.button_label != blank -%}
      <a class="lh-btn lh-btn--secondary lh-hide-mobile" href="{{ section.settings.button_link | default: '#lh-featured' }}">
        <span>{{ section.settings.button_label | escape }}</span>
        {% render 'lh-icon', icon: 'arrow-right' %}
      </a>
    {%- endif -%}

    <a
      class="lh-cart-icon"
      href="{{ routes.cart_url }}"
      data-lh-cart-open
      aria-label="Open cart, {{ cart.item_count }} items"
    >
      {% render 'lh-icon', icon: 'cart' %}
      <span class="lh-cart-icon__count" data-lh-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>
        {{- cart.item_count -}}
      </span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "lh-section lh-section--header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Loomhaus" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Clothes made to be worn for years, not seasons." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP THE DROP" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
