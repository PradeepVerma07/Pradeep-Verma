{%- comment -%}
  Product data for loomhaus.js. Includes variant-level metafields the Ajax API does not return.
  Accepts: product
{%- endcomment -%}
<script type="application/json" data-lh-product-json>
  {
    "id": {{ product.id }},
    "handle": {{ product.handle | json }},
    "title": {{ product.title | json }},
    "options": {{ product.options | json }},
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price }},
          "compare_at_price": {{ variant.compare_at_price | default: 0 }},
          "image_id": {{ variant.featured_media.id | default: 'null' }},
          "ribbon": {{ variant.metafields.custom.ribbon.value | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
