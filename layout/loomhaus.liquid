<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f6f3ed">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}

    {%- comment -%} Brand fonts from the Figma file: Bricolage Grotesque (display), Cabin (body), Lilita One (labels). {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Cabin:wdth,wght@75..100,400..700&family=Lilita+One&display=swap" rel="stylesheet">

    {{ 'loomhaus.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'loomhaus.js' | asset_url }}" defer="defer"></script>
    <script>
      window.Loomhaus = {
        routes: {
          root: {{ routes.root_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          cartUpdate: {{ routes.cart_update_url | append: '.js' | json }},
          cart: {{ routes.cart_url | append: '.js' | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        currency: {{ cart.currency.iso_code | json }}
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="lh-body">
    <a class="lh-skip-link" href="#MainContent">Skip to content</a>

    {% sections 'lh-header-group' %}

    <main id="MainContent" class="lh-main" role="main" tabindex="-1" data-template="{{ template }}">
      {{ content_for_layout }}
    </main>

    {% sections 'lh-footer-group' %}

    {%- comment -%} Overlays. Both are sections so the Section Rendering API can refresh them. {%- endcomment -%}
    {% section 'lh-cart-drawer' %}

    <lh-quick-view class="lh-modal lh-quick-view" id="LhQuickView" hidden>
      <div class="lh-modal__overlay" data-lh-close></div>
      <div class="lh-modal__dialog lh-quick-view__dialog" role="dialog" aria-modal="true" aria-label="Quick view" tabindex="-1">
        <div class="lh-quick-view__content" data-lh-quick-view-content></div>
      </div>
    </lh-quick-view>

    <div class="lh-visually-hidden" aria-live="polite" id="LhLiveRegion"></div>
  </body>
</html>
